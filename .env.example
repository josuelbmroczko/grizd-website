# ============================================================================
# Variáveis de ambiente — copie este arquivo para ".env" localmente
# e configure as mesmas chaves em Vercel > Project > Settings > Environment Variables
# ============================================================================

# Conexão com o banco Postgres (Vercel Postgres, Neon, Supabase, Railway, etc.)
# Deixe em branco / não configure ainda — o site funciona normalmente sem isso.
# Formato: postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=

# Senha de acesso à área /admin (login simples via cookie).
# Defina um valor forte antes de liberar o acesso ao admin em produção.
ADMIN_PASSWORD=

# Chave de API do Resend (para envio de emails do formulário de contato)
# Crie uma conta gratuita em resend.com e gere uma chave.
RESEND_API_KEY=
